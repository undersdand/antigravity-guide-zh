{
  "danger-command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/guard_command.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workspace-reminder": {
    "enabled": false,
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./scripts/session_banner.py",
        "timeout": 5
      }
    ]
  }
}
